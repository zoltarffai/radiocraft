{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "RadioCraft",
  "version": "0.2.0",
  "identifier": "dev.radiocraft.window",
  "build": {
    "frontendDist": "dist"
  },
  "app": {
    "windows": [],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": ["deb", "rpm"],
    "category": "Music",
    "publisher": "RadioCraft",
    "homepage": "https://github.com/radiocraft/radiocraft",
    "license": "GPL-3.0-only",
    "copyright": "Copyright (C) 2026 RadioCraft contributors",
    "shortDescription": "Radio playout engine",
    "longDescription": "RadioCraft is a radio playout application: music library, playlists, AutoDJ, cart walls, internet streams and a web/desktop UI. This package installs the desktop window shell; the engine server binary (radiocraft-server) is installed beside it and also runs standalone.",
    "externalBin": [],
    "resources": {
      "../../web/dist/": "web/dist/"
    },
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/icon.png"
    ],
    "linux": {
      "deb": {
        "files": {
          "/usr/bin/radiocraft-server": "radiocraft-server"
        }
      },
      "rpm": {
        "files": {
          "/usr/bin/radiocraft-server": "radiocraft-server"
        }
      }
    }
  }
}
